{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:webview:allow-set-webview-zoom",
    "dialog:default",
    "opener:default",
    "notification:default",
    "autostart:default",
    "global-shortcut:default"
  ]
}
