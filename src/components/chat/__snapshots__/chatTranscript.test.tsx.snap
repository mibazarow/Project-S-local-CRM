exports[`ChatTranscript DOM > renders the representative conversation with a stable markup 1`] = `
"<div class="chat-messages"><div class="pinned-bar" role="button" tabindex="0" title="Показать в переписке"><svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 16.5V22"></path><path d="M8.5 3h7l-1 6.5 2.5 3v1.5H7V12.5l2.5-3-1-6.5z"></path></svg><span class="txt">Закрепи пример и ответь</span></div><div class="msg user pinned" data-msg-key="1"><span class="who">Вы<span class="pin-mark" title="Закреплено"><svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 16.5V22"></path><path d="M8.5 3h7l-1 6.5 2.5 3v1.5H7V12.5l2.5-3-1-6.5z"></path></svg></span></span><span class="msg-actions"><button class="mini-btn on" type="button" title="Открепить"><svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 16.5V22"></path><path d="M8.5 3h7l-1 6.5 2.5 3v1.5H7V12.5l2.5-3-1-6.5z"></path></svg></button><button class="mini-btn" type="button" title="В заметку"><svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8l-5-5z"></path><path d="M14 3v5h5M9 13h6M9 17h4"></path></svg></button><button class="mini-btn" type="button" title="В задачу"><svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="3"></rect><path d="m8.5 12 2.5 2.5 5-5"></path></svg></button></span><div class="bubble">Закрепи пример и ответь</div><div class="msg-attachment doc" role="button" tabindex="0" title="Открыть файл"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><path d="M14 2v6h6"></path></svg><span class="cap">смета.pdf</span></div></div><div class="msg agent" data-msg-key="2"><span class="who">Агент</span><span class="msg-actions"><button class="mini-btn" type="button" title="Закрепить"><svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 16.5V22"></path><path d="M8.5 3h7l-1 6.5 2.5 3v1.5H7V12.5l2.5-3-1-6.5z"></path></svg></button><button class="mini-btn" type="button" title="В заметку"><svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8l-5-5z"></path><path d="M14 3v5h5M9 13h6M9 17h4"></path></svg></button><button class="mini-btn" type="button" title="В задачу"><svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="3"></rect><path d="m8.5 12 2.5 2.5 5-5"></path></svg></button></span><details class="reasoning"><summary>Размышления</summary><div class="reasoning-body"><div class="bubble md"><button class="msg-copy" type="button">Скопировать</button><div class="preview-body md"><p>Сначала посмотрю файл.</p>
</div></div></div></details><div class="bubble md"><button class="msg-copy" type="button">Скопировать</button><div class="preview-body md"><p><strong>Ответ</strong> агента с <code>кодом</code></p>
<div class="md-code"><pre><code class="language-js">console.log(1)
</code></pre><button type="button" class="md-code-copy">Скопировать</button></div>
</div></div><div class="msg-attachment doc" role="button" tabindex="0" title="Открыть файл"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><path d="M14 2v6h6"></path></svg><span class="cap">akt.pdf</span></div><details class="tool-steps"><summary>Действия агента (1)</summary><div class="tool-step "><span class="dot"></span><span class="nm">read_file</span><span class="args">path=a.txt</span><span class="res">ok</span></div></details><details class="compaction"><summary>Лимит контекста — делаю резюме</summary><div class="compaction-body"><div class="bubble md"><button class="msg-copy" type="button">Скопировать</button><div class="preview-body md"><p>Резюме контекста.</p>
</div></div></div></details><span class="note">Работа остановлена.</span></div><div class="msg agent" data-msg-key="3"><span class="who">Агент</span><span class="msg-actions"><button class="mini-btn" type="button" title="Закрепить"><svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 16.5V22"></path><path d="M8.5 3h7l-1 6.5 2.5 3v1.5H7V12.5l2.5-3-1-6.5z"></path></svg></button></span><div class="error">boom<br>Проверьте Настройки → Модель.</div></div><div class="msg agent"><span class="who">Агент</span><div class="bubble md"><button class="msg-copy" type="button">Скопировать</button><div class="preview-body md"><p>Стрим ответа…</p>
</div></div><details class="tool-steps"><summary>Действия агента (1)</summary><div class="tool-step "><span class="dot"></span><span class="nm">write_file</span><span class="args">path=b.txt</span><span class="res">…</span></div></details></div></div>"
`;

